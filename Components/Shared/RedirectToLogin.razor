@* Redirects anonymous visitors away from protected routes. *@
@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relative) ? "/dashboard" : $"/{relative}";
        NavigationManager.NavigateTo($"/?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}
