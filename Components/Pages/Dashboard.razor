@* =========================================================
   EMPLOYEE HOME DASHBOARD
   First authenticated page displayed after successful login.
   ========================================================= *@
@page "/dashboard"
@layout EmployeeLayout
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using SecureEmployeePortal.Data
@using SecureEmployeePortal.Services
@attribute [Authorize]
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AttendanceService AttendanceService
@inject SecureAssistantService SecureAssistantService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@* Browser-tab title for the employee dashboard. *@
<PageTitle>Dashboard | Secure Employee Portal</PageTitle>

<section class="dashboard-page">

   @* =========================================================
   DASHBOARD OVERVIEW ROW
   Combines the personalised greeting with a compact
   environment summary and current date.
   ========================================================= *@
<header class="dashboard-overview-row">

    @* Personalised employee greeting. *@
    <div class="dashboard-introduction">
        <h1>@Greeting, @DisplayFirstName 👋</h1>

        <p>Here’s what’s happening with your work today.</p>
    </div>

    @* =====================================================
       ACCOUNT ACCESS AND DATE SUMMARY
       Keeps the compact reference layout while showing real
       authenticated account information instead of placeholder live data.
       ===================================================== *@
    <div class="dashboard-day-summary">
        <section class="dashboard-weather dashboard-account-summary" aria-label="Account access summary">
            <span class="dashboard-account-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 3 20 6v6c0 5-2.9 8-8 10-5.1-2-8-5-8-10V6Z" />
                    <path d="m9.5 12 1.7 1.7 3.7-4" />
                </svg>
            </span>
            <div class="dashboard-weather-copy">
                <strong>@CurrentRole</strong>
                <span>@(CurrentUser is null ? "Account loading" : $"{CurrentUser.AccountStatus} account")</span>
            </div>
        </section>

        <span class="dashboard-summary-divider" aria-hidden="true"></span>

        <section class="dashboard-date" aria-label="Current date">
            <strong>@CurrentLocalTime.ToString("dddd")</strong>
            <time datetime="@CurrentDateAttribute">@CurrentLocalTime.ToString("d MMMM yyyy")</time>
        </section>
    </div>
</header>

    @* =========================================================
   DASHBOARD CONTENT GRID
   Establishes the wide primary workspace and the narrower
   information column shown in the dashboard reference.
   ========================================================= *@
<div class="dashboard-content-grid">

    @* =====================================================
       PRIMARY DASHBOARD WORKSPACE
       Contains attendance, account actions, links, guidance, and FAQs.
       ===================================================== *@
    <section class="dashboard-primary-column">

        @* Top dashboard row for attendance-related cards. *@
        <div class="dashboard-top-card-row">

           @* =========================================================
   TIME AND ATTENDANCE CARD
   Uses the authenticated employee's persisted attendance data.
   ========================================================= *@
<section class="attendance-card">
    <header class="attendance-card-header">
        <h2>Time &amp; Attendance</h2>
        <a href="/attendance"><span>View full timesheet</span><span aria-hidden="true">→</span></a>
    </header>

    <div class="attendance-card-content">
        <div class="attendance-status">
            <div class="attendance-current-time">
                <strong>@CurrentLocalTime.ToString("hh:mm")</strong>
                <span>@CurrentLocalTime.ToString("tt")</span>
            </div>

            <p>@(AttendanceSnapshot?.OpenRecord is null ? "You’re currently clocked out." : "You’re currently clocked in.")</p>

            <div class="attendance-since">
                <span class="attendance-status-dot" aria-hidden="true"></span>
                <span>@(AttendanceSnapshot?.OpenRecord is null
                    ? "Ready for your next work session"
                    : $"Since {AttendanceSnapshot.OpenRecord.ClockInAt.ToLocalTime():hh:mm tt}")</span>
            </div>
        </div>

        <div class="attendance-hours-progress" style="@AttendanceProgressStyle" role="img" aria-label="Today's recorded work hours">
            <div class="attendance-hours-copy">
                <span>Today’s Hours</span>
                <strong>@FormatDuration(AttendanceSnapshot?.TodayMinutes ?? 0)</strong>
                <small>/ 08:00 hrs</small>
            </div>
        </div>
    </div>

    <div class="attendance-actions">
        <button class="attendance-clock-out" type="button" disabled="@AttendanceBusy" @onclick="ToggleClockAsync">
            <span class="attendance-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="13" r="8" /><path d="M12 9v4l3 2" /><path d="M9 2h6" /><path d="M12 2v3" /></svg>
            </span>
            <span>@(AttendanceBusy ? "Saving…" : AttendanceSnapshot?.OpenRecord is null ? "Clock In" : "Clock Out")</span>
        </button>

        <button class="attendance-start-break" type="button" @onclick="GoToAttendance">
            <span class="attendance-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M5 5h14v14H5Z" /><path d="M8 9h8" /><path d="M8 13h8" /></svg>
            </span>
            <span>View History</span>
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(AttendanceMessage))
    {
        <div class="dashboard-inline-status" role="status">@AttendanceMessage</div>
    }
</section>

           @* =========================================================
   WEEKLY ATTENDANCE CARD
   Summarises persisted attendance for the current working week.
   ========================================================= *@
<section class="weekly-attendance-card">
    <header class="weekly-attendance-header">
        <h2>Attendance This Week</h2>
        <a href="/attendance">View all</a>
    </header>

    <div class="weekly-attendance-summary">
        <div class="weekly-attendance-count">
            <strong class="weekly-attendance-value">
                <span class="weekly-attendance-completed">@(AttendanceSnapshot?.DaysPresentThisWeek ?? 0)</span>
                <span class="weekly-attendance-total">/5</span>
            </strong>
            <span>Days Present</span>
        </div>

        <span class="weekly-attendance-status">@WeeklyStatusText</span>
    </div>

    <div class="weekly-attendance-chart" role="img" aria-label="Attendance status for the current working week">
        @foreach (var day in WeekDays)
        {
            <div class="weekly-attendance-day">
                <span class="weekly-day-marker @(day.IsPresent ? "is-complete" : "is-pending")" aria-hidden="true">@(day.IsPresent ? "✓" : string.Empty)</span>
                <span class="weekly-day-bar @(day.IsToday && day.IsPresent ? "is-current" : day.IsPresent ? "is-present" : "is-pending") @day.BarClass"></span>
                <span class="weekly-day-label">@day.Label</span>
            </div>
        }
    </div>
</section>

        </div>

        @* Middle dashboard row for account actions and quick links. *@
        <div class="dashboard-middle-card-row">

            @* =========================================================
   ACCOUNT ACTIONS CARD
   Keeps the reference card rhythm while linking only to real
   secure self-service workflows.
   ========================================================= *@
<section class="tasks-card">

    @* Card heading and link to the employee activity history. *@
    <header class="tasks-card-header">
        <h2>My Tasks</h2>

        <a href="/account-activity">View activity</a>
    </header>

    @* Real employee account-action links. *@
    <div class="tasks-list">

        @* Account-security action. *@
        <a class="task-item task-item-link" href="/security">

            <span class="task-icon task-icon-high" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="8" />
                    <circle cx="12" cy="12" r="3" />
                    <path d="M12 2v3" />
                </svg>
            </span>

            <div class="task-copy">
                <strong>Review Account Security</strong>
                <span>Check recent sign-ins and password status</span>
            </div>

            <span class="task-priority task-priority-high">Security</span>
        </a>

        @* Access-request action. *@
        <a class="task-item task-item-link" href="/requests">

            <span class="task-icon task-icon-medium" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5" y="4" width="14" height="17" rx="2" />
                    <path d="M9 4V2h6v2" />
                    <path d="m9 13 2 2 4-4" />
                </svg>
            </span>

            <div class="task-copy">
                <strong>Review Access Requests</strong>
                <span>Track pending access decisions</span>
            </div>

            <span class="task-priority task-priority-medium">Access</span>
        </a>

        @* Employee-profile action. *@
        <a class="task-item task-item-link" href="/profile">

            <span class="task-icon task-icon-low" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="3" />
                    <path d="M6 20c0-4 2.2-7 6-7s6 3 6 7" />
                </svg>
            </span>

            <div class="task-copy">
                <strong>Update Your Profile Information</strong>
                <span>Keep your details up to date</span>
            </div>

            <span class="task-priority task-priority-low">Profile</span>
        </a>

        @* Attendance-review action. *@
        <a class="task-item task-item-link" href="/attendance">

            <span class="task-icon task-icon-low" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5" y="6" width="14" height="14" rx="2" />
                    <path d="M9 6V4h6v2" />
                    <path d="M8 11h8" />
                    <path d="M8 15h6" />
                </svg>
            </span>

            <div class="task-copy">
                <strong>Review Attendance History</strong>
                <span>Confirm recent clock-in and clock-out records</span>
            </div>

            <span class="task-priority task-priority-low">Records</span>
        </a>
    </div>

    @* Link to the complete employee-task area. *@
    <a class="tasks-card-footer-link" href="/account-activity">
        <span>Review account activity</span>
        <span aria-hidden="true">→</span>
    </a>
</section>

           @* =========================================================
   QUICK LINKS CARD
   Provides direct access to frequently used employee
   self-service areas from the home dashboard.
   ========================================================= *@
<section class="quick-links-card">

    @* Quick-links heading. *@
    <header class="quick-links-header">
        <h2>Quick Links</h2>
    </header>

    @* =====================================================
       QUICK-LINK GRID
       Displays the core employee self-service destinations.
       ===================================================== *@
    <div class="quick-links-grid">

        @* Access-request shortcut. *@
        <a class="quick-link-item" href="/requests">
            <span class="quick-link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="4" y="5" width="16" height="15" rx="2" />
                    <path d="M8 3v4" />
                    <path d="M16 3v4" />
                    <path d="M4 9h16" />
                    <path d="M8 13h2" />
                    <path d="M14 13h2" />
                    <path d="M8 17h2" />
                </svg>
            </span>

            <span>Access Requests</span>
        </a>

        @* Attendance-history shortcut. *@
        <a class="quick-link-item" href="/attendance">
            <span class="quick-link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M7 3h8l4 4v14H7Z" />
                    <path d="M15 3v5h5" />
                    <path d="M14.5 11.5c-.6-.5-1.3-.8-2.2-.8-1.2 0-2 .6-2 1.5 0 2.2 4.2 1.1 4.2 3.4 0 .9-.8 1.5-2.2 1.5-.9 0-1.8-.3-2.4-.9" />
                    <path d="M12.3 9.5v8.8" />
                </svg>
            </span>

            <span>My Attendance</span>
        </a>

        @* Employee-profile shortcut. *@
        <a class="quick-link-item" href="/profile">
            <span class="quick-link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M3 7h7l2 2h9v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
                    <path d="M3 7V5a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v2" />
                </svg>
            </span>

            <span>My Profile</span>
        </a>

        @* Account-security shortcut. *@
        <a class="quick-link-item" href="/security">
            <span class="quick-link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="9" width="18" height="12" rx="1" />
                    <path d="M12 9v12" />
                    <path d="M3 13h18" />
                    <path d="M12 9H8.5C6.5 9 5 8 5 6.5S6.2 4 7.8 4C10.2 4 12 9 12 9Z" />
                    <path d="M12 9h3.5C17.5 9 19 8 19 6.5S17.8 4 16.2 4C13.8 4 12 9 12 9Z" />
                </svg>
            </span>

            <span>My Security</span>
        </a>

        @* Account-activity shortcut. *@
        <a class="quick-link-item" href="/account-activity">
            <span class="quick-link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="6" width="18" height="14" rx="2" />
                    <path d="M3 10h18" />
                    <path d="M8 16h3" />
                    <path d="M15 14v4" />
                    <path d="M13 16h4" />
                </svg>
            </span>

            <span>Account Activity</span>
        </a>

        @* Help-and-support shortcut. *@
        <a class="quick-link-item" href="/support">
            <span class="quick-link-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M4 13v-1a8 8 0 0 1 16 0v1" />
                    <path d="M4 13h3v6H5a2 2 0 0 1-2-2v-2a2 2 0 0 1 1-2Z" />
                    <path d="M20 13h-3v6h2a2 2 0 0 0 2-2v-2a2 2 0 0 0-1-2Z" />
                    <path d="M17 19c-1 2-2.7 3-5 3" />
                </svg>
            </span>

            <span>Help &amp; Support</span>
        </a>
    </div>

    @* Link to the broader employee-services area. *@
    <a class="quick-links-footer" href="/support">
        <span>Open Help &amp; Support</span>
        <span aria-hidden="true">→</span>
    </a>
</section>

        </div>

        @* Bottom dashboard row for support content. *@
        <div class="dashboard-bottom-card-row">

            @* =========================================================
   HELPFUL ARTICLES CARD
   Gives employees quick access to practical self-service
   guidance from the portal help centre.
   ========================================================= *@
<section class="helpful-articles-card">

    @* Card heading and link to the complete article library. *@
    <header class="helpful-articles-header">
        <h2>Helpful Articles</h2>

        <a href="/support">View all</a>
    </header>

    @* =====================================================
       ARTICLE LIST
       Displays three compact employee-help resources.
       ===================================================== *@
    <div class="helpful-articles-list">

        @* Access-request guidance article. *@
        <a class="helpful-article-item" href="/support">

            @* Article document icon. *@
            <span class="helpful-article-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5" y="3" width="14" height="18" rx="2" />
                    <path d="M9 8h6" />
                    <path d="M9 12h6" />
                    <path d="M9 16h4" />
                </svg>
            </span>

            @* Article title and description. *@
            <span class="helpful-article-copy">
                <strong>How Access Requests Work</strong>
                <span>Understand how protected access is requested and reviewed.</span>
            </span>
        </a>

        @* Attendance guidance article. *@
        <a class="helpful-article-item" href="/support">

            @* Article document icon. *@
            <span class="helpful-article-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5" y="3" width="14" height="18" rx="2" />
                    <path d="M9 8h6" />
                    <path d="M9 12h6" />
                    <path d="M9 16h4" />
                </svg>
            </span>

            @* Article title and description. *@
            <span class="helpful-article-copy">
                <strong>Using Time &amp; Attendance</strong>
                <span>Clock in, clock out and review your own attendance records.</span>
            </span>
        </a>

        @* Account-protection article. *@
        <a class="helpful-article-item" href="/support">

            @* Article document icon. *@
            <span class="helpful-article-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5" y="3" width="14" height="18" rx="2" />
                    <path d="M9 8h6" />
                    <path d="M9 12h6" />
                    <path d="M9 16h4" />
                </svg>
            </span>

            @* Article title and description. *@
            <span class="helpful-article-copy">
                <strong>Protecting Your Employee Account</strong>
                <span>Password, sign-in and account-security guidance.</span>
            </span>
        </a>
    </div>

    @* Link to the complete employee help centre. *@
    <a class="helpful-articles-footer" href="/support">
        <span>Open Help &amp; Support</span>
        <span aria-hidden="true">→</span>
    </a>
</section>

            @* =========================================================
   FREQUENTLY ASKED QUESTIONS CARD
   Gives employees quick access to common portal questions.
   Each question opens the functioning Secure Assistant with the question preloaded.
   ========================================================= *@
<section class="faq-card">

    @* Card heading and link to the complete help area. *@
    <header class="faq-card-header">
        <h2>Frequently Asked Questions</h2>

        <a href="/support">View all</a>
    </header>

    @* =====================================================
       FAQ QUESTION LIST
       Displays four compact employee-help questions.
       ===================================================== *@
    <div class="faq-list">

        @* Access-request question. *@
        <button class="faq-item" type="button" @onclick="AskAccessQuestion">
            <span class="faq-question-icon" aria-hidden="true">
                ?
            </span>

            <span class="faq-question-text">
                How do I request protected access?
            </span>

            <span class="faq-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="m8 10 4 4 4-4" />
                </svg>
            </span>
        </button>

        @* Personal-information question. *@
        <button class="faq-item" type="button" @onclick="AskProfileQuestion">
            <span class="faq-question-icon" aria-hidden="true">
                ?
            </span>

            <span class="faq-question-text">
                How can I update my personal information?
            </span>

            <span class="faq-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="m8 10 4 4 4-4" />
                </svg>
            </span>
        </button>

        @* Account-status question. *@
        <button class="faq-item" type="button" @onclick="AskSuspendedAccountQuestion">
            <span class="faq-question-icon" aria-hidden="true">
                ?
            </span>

            <span class="faq-question-text">
                What happens if my account is suspended?
            </span>

            <span class="faq-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="m8 10 4 4 4-4" />
                </svg>
            </span>
        </button>

        @* Account-activity question. *@
        <button class="faq-item" type="button" @onclick="AskActivityQuestion">
            <span class="faq-question-icon" aria-hidden="true">
                ?
            </span>

            <span class="faq-question-text">
                Where can I review sign-in activity?
            </span>

            <span class="faq-chevron" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="m8 10 4 4 4-4" />
                </svg>
            </span>
        </button>
    </div>
</section>


        </div>
    </section>

    @* =====================================================
       DASHBOARD INFORMATION COLUMN
       Contains security guidance, an account timeline, and employee help.
       ===================================================== *@
    <aside class="dashboard-information-column">

       @* =========================================================
   LATEST ANNOUNCEMENTS CARD
   Keeps the approved announcement-card treatment with security and access notices relevant to the authenticated employee.
   ========================================================= *@
<section class="announcements-card">

    @* Card heading and link to the wider support area. *@
    <header class="announcements-card-header">
        <h2>Latest Announcements</h2>

        <a href="/support">Help &amp; Support</a>
    </header>

    @* =====================================================
       ANNOUNCEMENT LIST
       Displays three practical employee-facing portal notices.
       ===================================================== *@
    <div class="announcements-list">

        @* Account-security guidance. *@
        <article class="announcement-item">

            @* Purple policy-document icon. *@
            <span class="announcement-icon announcement-icon-policy" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5" y="4" width="14" height="17" rx="2" />
                    <path d="M9 4V2h6v2" />
                    <path d="M9 10h6" />
                    <path d="M9 14h6" />
                    <path d="M9 18h4" />
                </svg>
            </span>

            @* Announcement wording and publication date. *@
            <div class="announcement-copy">
                <strong>Account Security Reminder</strong>

                <p>
                    Review recent sign-in activity and update your password if anything looks unfamiliar.
                </p>

                <span class="announcement-meta">Account protection</span>
            </div>
        </article>

        @* Password-recovery guidance. *@
        <article class="announcement-item">

            @* Orange maintenance icon. *@
            <span class="announcement-icon announcement-icon-maintenance" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M14.5 6.5a4.5 4.5 0 0 0-6 5.8L3 17.8 6.2 21l5.5-5.5a4.5 4.5 0 0 0 5.8-6l-2.8 2.8-3-3Z" />
                </svg>
            </span>

            @* Announcement wording and publication date. *@
            <div class="announcement-copy">
                <strong>Password Reset Protection</strong>

                <p>
                    Password-reset responses stay neutral so the portal does not reveal whether an email address exists.
                </p>

                <span class="announcement-meta">Privacy-safe recovery</span>
            </div>
        </article>

        @* Access-review guidance. *@
        <article class="announcement-item">

            @* Green wellness icon. *@
            <span class="announcement-icon announcement-icon-wellness" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.7A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" />
                    <path d="M7.5 12h2l1.2-2.4 2.1 5 1.2-2.6h2.5" />
                </svg>
            </span>

            @* Announcement wording and publication date. *@
            <div class="announcement-copy">
                <strong>Access Requests</strong>

                <p>
                    Requests for protected resources require an authorised administrator decision.
                </p>

                <span class="announcement-meta">Authorised review</span>
            </div>
        </article>
    </div>

    @* Keep the reference-style footer while routing to the real support area. *@
    <a class="announcements-card-footer" href="/support">
        <span>Open Help &amp; Support</span>
        <span aria-hidden="true">→</span>
    </a>
</section>

      @* =========================================================
   ACCOUNT TIMELINE CARD
   Uses real Identity timestamps rather than invented meetings or
   calendar data, keeping the dashboard honest and security-focused.
   ========================================================= *@
<section class="upcoming-events-card">
    <header class="upcoming-events-header">
        <h2>Account Timeline</h2>
        <a href="/account-activity">View activity</a>
    </header>

    <div class="upcoming-events-list">
        @foreach (var item in AccountTimeline)
        {
            <article class="upcoming-event-item">
                <time class="event-date-card" datetime="@item.When.ToString("yyyy-MM-dd")">
                    <span>@item.When.ToLocalTime().ToString("MMM").ToUpperInvariant()</span>
                    <strong>@item.When.ToLocalTime().ToString("dd")</strong>
                </time>
                <div class="event-details">
                    <div class="event-title-row">
                        <span class="event-status-dot @item.DotClass" aria-hidden="true"></span>
                        <strong>@item.Title</strong>
                    </div>
                    <span>@item.Detail</span>
                    <small>@item.When.ToLocalTime().ToString("HH:mm")</small>
                </div>
            </article>
        }
    </div>
</section>

