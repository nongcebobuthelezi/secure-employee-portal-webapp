@if (!AssistantOpen)
{
    <button class="secure-assistant-launcher" type="button" @onclick="OpenAssistant" aria-label="Open Secure Assistant">
        <img src="images/secure-assistant-icon.svg" alt="" aria-hidden="true" />
        <span>Ask Secure Assistant</span>
    </button>
}
else
{
    <section class="secure-assistant-panel" role="dialog" aria-modal="false" aria-labelledby="secure-assistant-title">
        <header class="secure-assistant-header">
            <div class="secure-assistant-identity">
                <span class="secure-assistant-avatar" aria-hidden="true">
                    <img src="images/secure-assistant-icon.svg" alt="" />
                </span>
                <div>
                    <strong id="secure-assistant-title">Secure Assistant</strong>
                    <span><i aria-hidden="true"></i> Online · Portal help</span>
                </div>
            </div>
            <button class="secure-assistant-close" type="button" @onclick="CloseAssistant" aria-label="Close Secure Assistant">×</button>
        </header>

        <div id="secure-assistant-messages" class="secure-assistant-messages" aria-live="polite" aria-label="Secure Assistant conversation">
            @foreach (var message in AssistantMessages)
            {
                <article class="secure-assistant-message @(message.IsUser ? "is-user" : "is-assistant")">
                    @if (!message.IsUser)
                    {
                        <img class="secure-assistant-message-avatar" src="images/secure-assistant-icon.svg" alt="" aria-hidden="true" />
                    }
                    <div class="secure-assistant-bubble">
                        <p>@message.Text</p>
                        @if (!string.IsNullOrWhiteSpace(message.ActionHref) && !string.IsNullOrWhiteSpace(message.ActionLabel))
                        {
                            <a class="secure-assistant-action" href="@message.ActionHref">@message.ActionLabel <span aria-hidden="true">→</span></a>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="secure-assistant-suggestions" aria-label="Suggested questions">
            @foreach (var suggestion in AssistantSuggestions)
            {
                <button type="button" @onclick="() => AskSuggestion(suggestion)">@suggestion</button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(AssistantError))
        {
            <p class="secure-assistant-error" role="alert">@AssistantError</p>
        }

        <div class="secure-assistant-composer">
            <label class="visually-hidden" for="secure-assistant-input">Ask Secure Assistant a question</label>
            <input
                id="secure-assistant-input"
                type="text"
                maxlength="240"
                placeholder="Type a message…"
                autocomplete="off"
                @bind="AssistantInput"
                @bind:event="oninput"
                @onkeydown="HandleAssistantKeyDown" />
            <button type="button" @onclick="SendAssistantMessage" disabled="@string.IsNullOrWhiteSpace(AssistantInput)" aria-label="Send message">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 4 17 8-17 8 3-8Z" /><path d="M7 12h14" /></svg>
            </button>
        </div>
    </section>
}

</section>

@code {
    // Authenticated dashboard state is loaded from Identity and the attendance database.
    private string DisplayFirstName { get; set; } = "Employee";
    private string CurrentRole { get; set; } = "Employee";
    private ApplicationUser? CurrentUser { get; set; }
    private AttendanceSnapshot? AttendanceSnapshot { get; set; }
    private bool AttendanceBusy { get; set; }
    private string? AttendanceMessage { get; set; }
    private DateTimeOffset CurrentLocalTime => DateTimeOffset.Now;
    private string CurrentDateAttribute => CurrentLocalTime.ToString("yyyy-MM-dd");
    private string Greeting => CurrentLocalTime.Hour switch { < 12 => "Good morning", < 18 => "Good afternoon", _ => "Good evening" };
    private int AttendanceProgressPercent => Math.Clamp((int)Math.Round((AttendanceSnapshot?.TodayMinutes ?? 0) / 480d * 100), 0, 100);
    private string AttendanceProgressStyle => $"--attendance-progress: {AttendanceProgressPercent}%;";

    [SupplyParameterFromQuery(Name = "assistant")]
    private string? AssistantQuery { get; set; }

    private bool AssistantOpen { get; set; }
    private string AssistantInput { get; set; } = string.Empty;
    private string? AssistantError { get; set; }
    private const int MaxAssistantMessages = 40;
    private bool AssistantNeedsFocus { get; set; }
    private bool AssistantNeedsScroll { get; set; }
    private List<DashboardAssistantMessage> AssistantMessages { get; } = [];
    private static readonly string[] AssistantSuggestions =
    [
        "How do I request access?",
        "Where can I change my password?",
        "Am I clocked in?",
        "What is my account status?"
    ];


    private IReadOnlyList<AccountTimelineItem> AccountTimeline
    {
        get
        {
            if (CurrentUser is null)
            {
                return [];
            }

            var passwordDate = CurrentUser.LastPasswordChangeAt ?? CurrentUser.CreatedAt;
            var passwordDetail = CurrentUser.LastPasswordChangeAt is null
                ? "No password change recorded since account creation"
                : "Password last changed";

            return
            [
                new(CurrentUser.LastLoginAt ?? CurrentUser.CreatedAt, "Latest sign-in", CurrentUser.LastLoginAt is null ? "No successful sign-in recorded yet" : "Successful authenticated session", "event-status-green"),
                new(passwordDate, "Password status", passwordDetail, "event-status-blue"),
                new(CurrentUser.CreatedAt, "Account created", $"{CurrentRole} access · {CurrentUser.AccountStatus}", "event-status-purple")
            ];
        }
    }

    private string WeeklyStatusText => (AttendanceSnapshot?.DaysPresentThisWeek ?? 0) switch
    {
        >= 5 => "Week Complete",
        >= 3 => "On Track",
        >= 1 => "In Progress",
        _ => "No Records Yet"
    };

    private IReadOnlyList<WeekDayItem> WeekDays
    {
        get
        {
            var today = DateTimeOffset.Now.Date;
            var monday = today.AddDays(-(((int)DateTimeOffset.Now.DayOfWeek + 6) % 7));
            var presentDates = AttendanceSnapshot?.History
                .Select(record => record.ClockInAt.ToLocalTime().Date)
                .ToHashSet() ?? [];

            var labels = new[] { "Mon", "Tue", "Wed", "Thu", "Fri" };
            var bars = new[] { "bar-monday", "bar-tuesday", "bar-wednesday", "bar-thursday", "bar-friday" };
            return Enumerable.Range(0, 5)
                .Select(index => new WeekDayItem(
                    labels[index],
                    bars[index],
                    presentDates.Contains(monday.AddDays(index)),
                    monday.AddDays(index) == today))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(userId))
        {
            // Use a short-lived factory context rather than the scoped Identity context.
            // The dashboard and authenticated layout can initialize concurrently during
            // navigation, so sharing UserManager's DbContext here can trigger EF Core's
            // "second operation" concurrency guard.
            await using var db = await DbFactory.CreateDbContextAsync();
            CurrentUser = await db.Users
                .AsNoTracking()
                .SingleOrDefaultAsync(user => user.Id == userId);

            if (CurrentUser is not null)
            {
                DisplayFirstName = string.IsNullOrWhiteSpace(CurrentUser.FirstName) ? "Employee" : CurrentUser.FirstName;
                CurrentRole = authState.User.Claims
                    .FirstOrDefault(claim => claim.Type == ClaimTypes.Role)?.Value ?? "Employee";
                AttendanceSnapshot = await AttendanceService.GetSnapshotAsync(CurrentUser.Id, 30);
            }
        }

        EnsureAssistantWelcomeMessage();
    }

    protected override void OnParametersSet()
    {
        // Query-string launch requests can arrive while the dashboard component is
        // already alive (for example, clicking the top-bar help control while on
        // /dashboard). Handle them on parameter updates, not only at initialization.
        if (string.Equals(AssistantQuery, "open", StringComparison.OrdinalIgnoreCase))
        {
            AssistantOpen = true;
            AssistantError = null;
            AssistantNeedsFocus = true;
            AssistantNeedsScroll = true;
            EnsureAssistantWelcomeMessage();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (AssistantNeedsFocus)
        {
            AssistantNeedsFocus = false;
            await JSRuntime.InvokeVoidAsync("securePortalAssistant.focusInput");
        }

        if (AssistantNeedsScroll)
        {
            AssistantNeedsScroll = false;
            await JSRuntime.InvokeVoidAsync("securePortalAssistant.scrollToLatest");
        }
    }

    private async Task ToggleClockAsync()
    {
        if (CurrentUser is null || AttendanceBusy) return;

        AttendanceBusy = true;
        try
        {
            var result = AttendanceSnapshot?.OpenRecord is null
                ? await AttendanceService.ClockInAsync(CurrentUser.Id)
                : await AttendanceService.ClockOutAsync(CurrentUser.Id);

            AttendanceMessage = result.Message;
            AttendanceSnapshot = await AttendanceService.GetSnapshotAsync(CurrentUser.Id, 30);
        }
        finally
        {
            AttendanceBusy = false;
        }
    }

    private void OpenAssistant()
    {
        AssistantOpen = true;
        AssistantError = null;
        AssistantNeedsFocus = true;
        AssistantNeedsScroll = true;
        EnsureAssistantWelcomeMessage();
    }

    private void OpenAssistantWithQuestion(string question)
    {
        AssistantOpen = true;
        AssistantInput = question;
        AssistantError = null;
        EnsureAssistantWelcomeMessage();
        SendAssistantMessage();
        AssistantNeedsFocus = true;
    }

    private void CloseAssistant()
    {
        AssistantOpen = false;

        // Clear the launch query after the panel is closed. Without this, clicking
        // the top-bar Need help? link again while already on /dashboard?assistant=open
        // can navigate to the same URI and fail to trigger another parameter update.
        if (string.Equals(AssistantQuery, "open", StringComparison.OrdinalIgnoreCase))
        {
            AssistantQuery = null;
            NavigationManager.NavigateTo("/dashboard", replace: true);
        }
    }

    private void AskAccessQuestion() => OpenAssistantWithQuestion("How do I request protected access?");

    private void AskProfileQuestion() => OpenAssistantWithQuestion("How can I update my personal information?");

    private void AskSuspendedAccountQuestion() => OpenAssistantWithQuestion("What happens if my account is suspended?");

    private void AskActivityQuestion() => OpenAssistantWithQuestion("Where can I review sign-in activity?");

    private void AskSuggestion(string suggestion)
    {
        AssistantInput = suggestion;
        SendAssistantMessage();
    }

    private void SendAssistantMessage()
    {
        var input = AssistantInput.Trim();
        if (input.Length == 0)
        {
            AssistantError = "Type a question before sending.";
            return;
        }

        AssistantError = null;
        AssistantMessages.Add(new(true, input));
        AssistantInput = string.Empty;

        try
        {
            var reply = SecureAssistantService.GetReply(
                input,
                CurrentRole,
                CurrentUser?.AccountStatus ?? AccountStatus.Active,
                AttendanceSnapshot?.OpenRecord is not null,
                AttendanceSnapshot?.TodayMinutes);

            AssistantMessages.Add(new(false, reply.Message, reply.ActionLabel, reply.ActionHref));
            TrimAssistantHistory();
            AssistantNeedsScroll = true;
        }
        catch
        {
            AssistantError = "Secure Assistant could not respond. Use Help & Support for the available self-service routes.";
        }
    }

    private void HandleAssistantKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseAssistant();
            return;
        }

        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(AssistantInput))
        {
            SendAssistantMessage();
        }
    }

    private void EnsureAssistantWelcomeMessage()
    {
        if (AssistantMessages.Count != 0) return;

        AssistantMessages.Add(new(
            false,
            $"Hi {DisplayFirstName}. I’m the Secure Assistant. I can help with account access, passwords, attendance, profile updates, requests and recent account activity."));
    }

    private void TrimAssistantHistory()
    {
        while (AssistantMessages.Count > MaxAssistantMessages)
        {
            AssistantMessages.RemoveAt(0);
        }
    }

    private void GoToSupport() => NavigationManager.NavigateTo("/support");

    private void GoToAttendance() => NavigationManager.NavigateTo("/attendance");

    private static string FormatDuration(int minutes) => $"{minutes / 60:00}:{minutes % 60:00}";

    private sealed record WeekDayItem(string Label, string BarClass, bool IsPresent, bool IsToday);
    private sealed record AccountTimelineItem(DateTimeOffset When, string Title, string Detail, string DotClass);
    private sealed record DashboardAssistantMessage(
        bool IsUser,
        string Text,
        string? ActionLabel = null,
        string? ActionHref = null);
}
