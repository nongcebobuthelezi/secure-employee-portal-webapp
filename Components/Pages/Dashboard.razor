@* =========================================================
   EMPLOYEE HOME DASHBOARD
   First authenticated page displayed after successful login.
   ========================================================= *@
@page "/dashboard"
@layout EmployeeLayout

@* Browser-tab title for the employee dashboard. *@
<PageTitle>Dashboard | Secure Employee Portal</PageTitle>

<section class="dashboard-page">

   @* =========================================================
   DASHBOARD OVERVIEW ROW
   Combines the personalised greeting with the employee’s
   current weather and date summary.
   ========================================================= *@
<header class="dashboard-overview-row">

    @* Personalised employee greeting. *@
    <div class="dashboard-introduction">
        <h1>Good morning, Nongcebo 👋</h1>

        <p>Here’s what’s happening with your work today.</p>
    </div>

    @* =====================================================
       WEATHER AND DATE SUMMARY
       These values are visual placeholders for now. They can
       later be connected to live weather and system dates.
       ===================================================== *@
    <div class="dashboard-day-summary">

        @* Current weather summary. *@
        <section class="dashboard-weather" aria-label="Current weather">

            @* =========================================================
   POLISHED PARTLY-CLOUDY WEATHER ICON
   Uses layered gradients and subtle depth while preserving
   the existing weather-summary dimensions and position.
   ========================================================= *@
<span class="dashboard-weather-icon" aria-hidden="true">
    <svg viewBox="0 0 52 48">

        @* Colour gradients used by the sun and cloud. *@
        <defs>
            <linearGradient
                id="dashboardSunGradient"
                x1="22"
                y1="6"
                x2="39"
                y2="24"
                gradientUnits="userSpaceOnUse">

                <stop offset="0%" stop-color="#FFD84A" />
                <stop offset="55%" stop-color="#FFB515" />
                <stop offset="100%" stop-color="#F49300" />
            </linearGradient>

            <linearGradient
                id="dashboardCloudGradient"
                x1="14"
                y1="20"
                x2="39"
                y2="43"
                gradientUnits="userSpaceOnUse">

                <stop offset="0%" stop-color="#FFFFFF" />
                <stop offset="58%" stop-color="#EAF3FC" />
                <stop offset="100%" stop-color="#C9DFF2" />
            </linearGradient>
        </defs>

        @* Soft sunlight rays behind the cloud. *@
        <g class="dashboard-weather-rays">
            <path d="M34 3v5" />
            <path d="m44 7-3.5 3.5" />
            <path d="M48 17h-5" />
            <path d="m24 7 3.5 3.5" />
        </g>

        @* Warm gradient sun partly hidden behind the cloud. *@
        <circle
            class="dashboard-weather-sun"
            cx="34"
            cy="17"
            r="9" />

        @* Soft blue shadow beneath the main cloud. *@
        <path
            class="dashboard-weather-cloud-shadow"
            d="M12 39h29c4 0 7-3 7-6.8 0-3.2-2.2-5.9-5.3-6.6-.9-5.7-5.6-9.8-11.5-9.8-4.8 0-8.9 2.7-10.7 6.8C14.7 22.8 10 27.4 10 33c0 2.4.7 4.4 2 6Z" />

        @* Main bright cloud shape. *@
        <path
            class="dashboard-weather-cloud"
            d="M10 37h30.5c3.6 0 6.5-2.7 6.5-6.1 0-3-2.2-5.5-5.2-5.9-.8-5.2-5.1-9-10.5-9-4.5 0-8.4 2.6-10 6.5C15.9 22.8 12 27 12 32c0 1.9-.7 3.6-2 5Z" />
    </svg>
</span>

            @* Weather temperature and condition. *@
            <div class="dashboard-weather-copy">
                <strong>18°C</strong>
                <span>Partly cloudy</span>
            </div>
        </section>

        @* Vertical separator between weather and date. *@
        <span class="dashboard-summary-divider" aria-hidden="true"></span>

        @* Current date summary. *@
        <section class="dashboard-date" aria-label="Current date">
            <strong>Tuesday</strong>

            <time datetime="2026-08-04">
                4 August 2026
            </time>
        </section>
    </div>
</header>

    @* =========================================================
   DASHBOARD CONTENT GRID
   Establishes the wide primary workspace and the narrower
   information column shown in the dashboard reference.
   ========================================================= *@
<div class="dashboard-content-grid">

    @* =====================================================
       PRIMARY DASHBOARD WORKSPACE
       Contains attendance, tasks, links, articles, and FAQs.
       ===================================================== *@
    <section class="dashboard-primary-column">

        @* Top dashboard row for attendance-related cards. *@
        <div class="dashboard-top-card-row">

           @* =========================================================
   TIME AND ATTENDANCE CARD
   Shows the employee’s current clocking status, today’s
   worked hours, and the main attendance actions.
   ========================================================= *@
<section class="attendance-card">

    @* Card heading and link to the full timesheet. *@
    <header class="attendance-card-header">
        <h2>Time &amp; Attendance</h2>

        <a href="/attendance">
            <span>View full timesheet</span>
            <span aria-hidden="true">→</span>
        </a>
    </header>

    @* Current time and today’s worked-hours progress. *@
    <div class="attendance-card-content">

        @* Employee’s current clocking status. *@
        <div class="attendance-status">

            @* Current clock time. Static for the visual build. *@
            <div class="attendance-current-time">
                <strong>09:15</strong>
                <span>AM</span>
            </div>

            <p>You’re currently clocked in.</p>

            @* Time at which the employee clocked in. *@
            <div class="attendance-since">
                <span class="attendance-status-dot" aria-hidden="true"></span>
                <span>Since 09:00 AM</span>
            </div>
        </div>

        @* Circular visual showing today’s completed hours. *@
        <div
            class="attendance-hours-progress"
            role="img"
            aria-label="One hour and fifteen minutes worked out of eight hours">

            <div class="attendance-hours-copy">
                <span>Today’s Hours</span>
                <strong>01:15</strong>
                <small>/ 08:00 hrs</small>
            </div>
        </div>
    </div>

    @* Clocking actions shown at the bottom of the card. *@
    <div class="attendance-actions">

        @* Main action for ending the employee’s work session. *@
        <button class="attendance-clock-out" type="button">
            <span class="attendance-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="13" r="8" />
                    <path d="M12 9v4l3 2" />
                    <path d="M9 2h6" />
                    <path d="M12 2v3" />
                </svg>
            </span>

            <span>Clock Out</span>
        </button>

        @* Secondary action for beginning a scheduled break. *@
        <button class="attendance-start-break" type="button">
            <span class="attendance-action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M6 8h10v7a4 4 0 0 1-4 4h-2a4 4 0 0 1-4-4Z" />
                    <path d="M16 10h2a2 2 0 0 1 0 4h-2" />
                    <path d="M8 4c0 1 1 1 1 2" />
                    <path d="M12 4c0 1 1 1 1 2" />
                </svg>
            </span>

            <span>Start Break</span>
        </button>
    </div>
</section>

           @* =========================================================
   WEEKLY ATTENDANCE CARD
   Summarises the employee’s attendance across the current
   working week using a compact five-day chart.
   ========================================================= *@
<section class="weekly-attendance-card">

    @* Card heading and link to detailed attendance records. *@
    <header class="weekly-attendance-header">
        <h2>Attendance This Week</h2>

        <a href="/attendance">View all</a>
    </header>

    @* Weekly attendance count and current status. *@
    <div class="weekly-attendance-summary">

       @* =========================================================
   WEEKLY ATTENDANCE TOTAL
   Keeps the attended-day count blue while displaying the
   divider and total working days in a softer grey.
   ========================================================= *@
<div class="weekly-attendance-count">

    @* Split the value so each part can use its own colour. *@
    <strong class="weekly-attendance-value">
        <span class="weekly-attendance-completed">4</span>
        <span class="weekly-attendance-total">/5</span>
    </strong>

    <span>Days Present</span>
</div>

        @* Positive attendance-status label. *@
        <span class="weekly-attendance-status">
            On Track
        </span>
    </div>

    @* =====================================================
       FIVE-DAY ATTENDANCE CHART
       Uses static design values for now. Real attendance
       records will later determine each day’s state.
       ===================================================== *@
    <div
        class="weekly-attendance-chart"
        role="img"
        aria-label="Present Monday through Thursday, with Friday remaining">

        @* Monday attendance. *@
        <div class="weekly-attendance-day">
            <span class="weekly-day-marker is-complete" aria-hidden="true">
                ✓
            </span>

            <span class="weekly-day-bar is-present bar-monday"></span>
            <span class="weekly-day-label">Mon</span>
        </div>

        @* Tuesday attendance. *@
        <div class="weekly-attendance-day">
            <span class="weekly-day-marker is-complete" aria-hidden="true">
                ✓
            </span>

            <span class="weekly-day-bar is-present bar-tuesday"></span>
            <span class="weekly-day-label">Tue</span>
        </div>

        @* Wednesday attendance. *@
        <div class="weekly-attendance-day">
            <span class="weekly-day-marker is-complete" aria-hidden="true">
                ✓
            </span>

            <span class="weekly-day-bar is-present bar-wednesday"></span>
            <span class="weekly-day-label">Wed</span>
        </div>

        @* Thursday is highlighted as the current working day. *@
        <div class="weekly-attendance-day">
            <span class="weekly-day-marker is-complete" aria-hidden="true">
                ✓
            </span>

            <span class="weekly-day-bar is-current bar-thursday"></span>
            <span class="weekly-day-label">Thu</span>
        </div>

        @* Friday remains incomplete. *@
        <div class="weekly-attendance-day">
            <span class="weekly-day-marker is-pending" aria-hidden="true"></span>

            <span class="weekly-day-bar is-pending bar-friday"></span>
            <span class="weekly-day-label">Fri</span>
        </div>
    </div>
</section>

        </div>

        @* Middle dashboard row for tasks and quick links. *@
        <div class="dashboard-middle-card-row">

            @* =========================================================
   MY TASKS CARD
   Shows the employee’s current actions, deadlines, and
   priority levels from the dashboard reference.
   ========================================================= *@
<section class="tasks-card">

    @* Card heading and link to the full task list. *@
    <header class="tasks-card-header">
        <h2>My Tasks</h2>

        <a href="/tasks">View all</a>
    </header>

    @* Current employee task list. *@
    <div class="tasks-list">

        @* High-priority compliance-training task. *@
        <article class="task-item">

            <span class="task-icon task-icon-high" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="8" />
                    <circle cx="12" cy="12" r="3" />
                    <path d="M12 2v3" />
                </svg>
            </span>

            <div class="task-copy">
                <strong>Complete Compliance Training</strong>
                <span>Due by 20 May 2025</span>
            </div>

            <span class="task-priority task-priority-high">
                High
            </span>
        </article>

        @* Medium-priority data-policy task. *@
        <article class="task-item">

            <span class="task-icon task-icon-medium" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5" y="4" width="14" height="17" rx="2" />
                    <path d="M9 4V2h6v2" />
                    <path d="m9 13 2 2 4-4" />
                </svg>
            </span>

            <div class="task-copy">
                <strong>Acknowledge Updated Data Policy</strong>
                <span>Due by 22 May 2025</span>
            </div>

            <span class="task-priority task-priority-medium">
                Medium
            </span>
        </article>

        @* Low-priority employee-profile task. *@
        <article class="task-item">

            <span class="task-icon task-icon-low" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="3" />
                    <path d="M6 20c0-4 2.2-7 6-7s6 3 6 7" />
                </svg>
            </span>

            <div class="task-copy">
                <strong>Update Your Profile Information</strong>
                <span>Keep your details up to date</span>
            </div>

            <span class="task-priority task-priority-low">
                Low
            </span>
        </article>

        @* Low-priority payslip-review task. *@
        <article class="task-item">

            <span class="task-icon task-icon-low" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5" y="6" width="14" height="14" rx="2" />
                    <path d="M9 6V4h6v2" />
                    <path d="M8 11h8" />
                    <path d="M8 15h6" />
                </svg>
            </span>

            <div class="task-copy">
                <strong>Review May 2025 Payslip</strong>
                <span>Available in Payroll section</span>
            </div>

            <span class="task-priority task-priority-low">
                Low
            </span>
        </article>
    </div>

    @* Link to the complete employee-task area. *@
    <a class="tasks-card-footer-link" href="/tasks">
        <span>Go to all tasks</span>
        <span aria-hidden="true">→</span>
    </a>
</section>

