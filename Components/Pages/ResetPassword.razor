@* Token-backed password-reset page. *@
@page "/reset-password"
@layout AuthLayout
@rendermode InteractiveServer
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using SecureEmployeePortal.Data
@using SecureEmployeePortal.Models
@inject UserManager<ApplicationUser> UserManager
@inject SecureEmployeePortal.Services.PortalActivityService ActivityService
@inject NavigationManager NavigationManager

<PageTitle>Reset Password | Secure Employee Portal</PageTitle>

<main class="login-shell auth-reset-page">
    <section class="login-visual-panel">
        <div class="brand-row">
            <div class="brand-icon" aria-hidden="true"><svg viewBox="0 0 72 78">
                    <defs>
                        <linearGradient id="brandShieldStroke" x1="36" y1="5" x2="36" y2="73" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#5EE4EA" />
                            <stop offset="48%" stop-color="#3CB6E8" />
                            <stop offset="100%" stop-color="#3269E5" />
                        </linearGradient>
                    </defs>
                    <path class="brand-shield-depth" d="M36 6 L61 15 V34 C61 51 51 65 36 72 C21 65 11 51 11 34 V15 Z" />
                    <path class="brand-shield-outline" d="M36 4 L61 13 V32 C61 49 51 63 36 70 C21 63 11 49 11 32 V13 Z" />
                    <circle class="brand-person-head" cx="36" cy="27" r="7.5" />
                    <path class="brand-person-body" d="M22 53 C22 43.5 28.2 37 36 37 C43.8 37 50 43.5 50 53 C50 55.2 48.2 57 46 57 H26 C23.8 57 22 55.2 22 53 Z" />
                </svg></div>
            <div><h1 class="brand-name">Secure <span>Employee Portal</span></h1><p class="brand-tagline">Secure Access. Trusted People. Stronger Organization.</p></div>
        </div>
        <div class="visual-content">
            <div class="visual-intro-row"><div class="dot-grid" aria-hidden="true"></div><div class="visual-copy"><h2>Your security is our priority</h2><p class="visual-description">Create a strong new password to protect your account and company data.</p></div></div>
            <div class="illustration-wrapper"><img src="images/reset-password-illustration.png" alt="Password reset illustration" /></div>
        </div>
    </section>

    <section class="login-form-panel">
        <div class="form-panel-inner">
            <div class="security-badge">
                <span class="security-badge-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.8 8.8 7 10 4.2-1.2 7-5.4 7-10V6l-7-3Z" /><path d="m9.5 11.5 1.7 1.5 3.3-3.5" /></svg>
                </span>
                <span>Identity Protected</span>
            </div>
            <p class="reset-back-link"><a href="/">← Back to sign in</a></p>
            <div class="form-heading"><h2>Reset password</h2><p>Choose a new password for your employee account.</p></div>

            @if (Succeeded || Completed)
            {
                <div class="portal-success-message"><strong>Password changed.</strong> You can now return to sign in.</div>
                <p class="create-account"><a href="/">Return to sign in →</a></p>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="portal-error-message" role="alert">@ErrorMessage</div>
                }

                <EditForm Model="Input" OnValidSubmit="ResetAsync" FormName="reset-password" class="login-form reset-password-form">
                    <DataAnnotationsValidator />
                    <div class="form-group">
                        <label for="new-password">New password</label>
                        <div class="input-with-icon password-input">
                            <span class="field-icon field-icon-left" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                </span>
                            <InputText id="new-password" type="password" autocomplete="new-password" maxlength="100" @bind-Value="Input.Password" placeholder="Enter your new password" />
                            <button class="password-visibility-toggle" type="button" data-password-toggle="new-password" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                    <circle cx="12" cy="12" r="2.5" />
                </svg></button>
                        </div>
                        <ValidationMessage For="() => Input.Password" />
                    </div>
                    <div class="form-group">
                        <label for="confirm-new-password">Confirm new password</label>
                        <div class="input-with-icon password-input">
                            <span class="field-icon field-icon-left" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="10" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3" /></svg>
                </span>
                            <InputText id="confirm-new-password" type="password" autocomplete="new-password" maxlength="100" @bind-Value="Input.ConfirmPassword" placeholder="Confirm your new password" />
                            <button class="password-visibility-toggle" type="button" data-password-toggle="confirm-new-password" aria-label="Show password" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                    <circle cx="12" cy="12" r="2.5" />
                </svg></button>
                        </div>
                        <ValidationMessage For="() => Input.ConfirmPassword" />
                    </div>
                    <div class="reset-password-requirements">
                        <strong>Password must include:</strong>
                        <div class="reset-requirements-list">
                            <div class="reset-requirement"><span class="requirement-check">✓</span><span>At least 8 characters</span></div>
                            <div class="reset-requirement"><span class="requirement-check">✓</span><span>An uppercase letter</span></div>
                            <div class="reset-requirement"><span class="requirement-check">✓</span><span>A lowercase letter</span></div>
                            <div class="reset-requirement"><span class="requirement-check">✓</span><span>A number</span></div>
                            <div class="reset-requirement"><span class="requirement-check">✓</span><span>A special character</span></div>
                        </div>
                    </div>
                    <button class="sign-in-button" type="submit" disabled="@IsBusy">@(IsBusy ? "Resetting…" : "Reset password")</button>
                </EditForm>
            }
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? Email { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? Code { get; set; }
    [SupplyParameterFromQuery(Name = "completed")] public bool Completed { get; set; }

    private ResetPasswordInputModel Input { get; set; } = new();
    private bool Succeeded { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }

    protected override void OnParametersSet()
    {
        if (string.IsNullOrWhiteSpace(Input.Email)) Input.Email = Email ?? string.Empty;
        if (string.IsNullOrWhiteSpace(Input.Code)) Input.Code = Code ?? string.Empty;
    }

    private async Task ResetAsync()
    {
        if (IsBusy)
        {
            return;
        }

        IsBusy = true;
        ErrorMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(Input.Email) || string.IsNullOrWhiteSpace(Input.Code))
            {
                ErrorMessage = "This password-reset link is incomplete or invalid.";
                return;
            }

            var user = await UserManager.FindByEmailAsync(Input.Email.Trim());
            if (user is null)
            {
                ErrorMessage = "This password-reset link is invalid or has expired.";
                return;
            }

            string token;
            try
            {
                token = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Input.Code));
            }
            catch (FormatException)
            {
                ErrorMessage = "This password-reset link is invalid or has expired.";
                return;
            }

            // Save the timestamp as part of Identity's successful password update so the
            // security metadata cannot diverge because a separate follow-up write failed.
            var previousPasswordChangeAt = user.LastPasswordChangeAt;
            user.LastPasswordChangeAt = DateTimeOffset.UtcNow;
            var result = await UserManager.ResetPasswordAsync(user, token, Input.Password);
            if (!result.Succeeded)
            {
                user.LastPasswordChangeAt = previousPasswordChangeAt;
                ErrorMessage = "This password-reset link is invalid, expired, or the new password does not meet the required rules.";
                await ActivityService.RecordSecurityEventAsync(user.Id, "PasswordResetFailed", false, "Password reset failed.");
                return;
            }

            await ActivityService.RecordSecurityEventAsync(user.Id, "PasswordResetCompleted", true, "Password reset completed successfully.");

            // Remove the now-consumed reset token and email address from the visible URL and
            // clear the password values held by this server-side component instance.
            Input = new ResetPasswordInputModel();
            Succeeded = true;
            NavigationManager.NavigateTo("/reset-password?completed=true", replace: true);
        }
        finally
        {
            IsBusy = false;
        }
    }
}
