@* =========================================================
   RESET-PASSWORD PAGE ROUTE
   Creates the separate page for choosing a new password.
   ========================================================= *@
@page "/reset-password"
@layout AuthLayout

@* Browser-tab title for the reset-password page. *@
<PageTitle>Reset Password | Secure Employee Portal</PageTitle>

<main class="login-shell">
    <section class="login-visual-panel">
        <div class="brand-row">
<div class="brand-icon" aria-hidden="true">
    <svg viewBox="0 0 72 78">
        <defs>
            <linearGradient
                id="brandShieldStroke"
                x1="36"
                y1="5"
                x2="36"
                y2="73"
                gradientUnits="userSpaceOnUse">

                <stop offset="0%" stop-color="#5EE4EA" />
                <stop offset="48%" stop-color="#3CB6E8" />
                <stop offset="100%" stop-color="#3269E5" />
            </linearGradient>
        </defs>

        <path
            class="brand-shield-depth"
            d="M36 6
               L61 15
               V34
               C61 51 51 65 36 72
               C21 65 11 51 11 34
               V15
               Z" />

        <path
            class="brand-shield-outline"
            d="M36 4
               L61 13
               V32
               C61 49 51 63 36 70
               C21 63 11 49 11 32
               V13
               Z" />

        <circle
            class="brand-person-head"
            cx="36"
            cy="27"
            r="7.5" />

        <path
            class="brand-person-body"
            d="M22 53
               C22 43.5 28.2 37 36 37
               C43.8 37 50 43.5 50 53
               C50 55.2 48.2 57 46 57
               H26
               C23.8 57 22 55.2 22 53
               Z" />
    </svg>
</div>
            <div>
                <h1 class="brand-name">
                    Secure <span>Employee Portal</span>
                </h1>

                <p class="brand-tagline">
                    Secure Access. Trusted People. Stronger Organization.
                </p>
            </div>
        </div>

      <div class="visual-content">
    <div class="visual-intro-row">
        <div class="dot-grid" aria-hidden="true"></div>

       @* =========================================================
   RESET-PASSWORD PAGE INTRODUCTION
   Changes only the wording while preserving the approved
   position, typography, spacing, and left-panel structure.
   ========================================================= *@
<div class="visual-copy">
    @* Reset-password security heading. *@
    <h2>Your security is our priority</h2>

    @* Supporting message for creating a secure new password. *@
    <p class="visual-description">
        Create a strong new password to keep your account
        and company data safe.
    </p>
</div>

    </div>

    @* =========================================================
   RESET-PASSWORD ILLUSTRATION
   Uses the dedicated password-reset security artwork while
   preserving the existing wrapper, position, and page layout.
   ========================================================= *@
<div class="illustration-wrapper">
    <img
        src="images/reset-password-illustration.png"
        alt="Secure laptop with password confirmation, protective shield and plant" />
</div>

</div>

        <div class="feature-row">
    <div class="feature-item">
        <div class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <rect x="5" y="10" width="14" height="10" rx="2" />
                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
            </svg>
        </div>

        <div class="feature-copy">
            <strong>Secure Access</strong>
            <span>Enterprise-grade security</span>
        </div>
    </div>

    <div class="feature-item">
        <div class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21a8 8 0 0 1 16 0" />
            </svg>
        </div>

        <div class="feature-copy">
            <strong>Personalized</strong>
            <span>Resources and tools just for you</span>
        </div>
    </div>

    <div class="feature-item">
        <div class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                <path d="M10 21h4" />
            </svg>
        </div>

        <div class="feature-copy">
            <strong>Stay Informed</strong>
            <span>Updates, alerts and announcements</span>
        </div>
    </div>
</div>

    </section>

    <section class="login-form-panel">
        <div class="form-panel-inner">
            @* =========================================================
   ENTERPRISE SECURE BADGE
   Adds the small outlined security icon shown in the reference.
   ========================================================= *@
<div class="security-badge">
    @* Small outlined shield icon positioned before the badge text. *@
    <span class="security-badge-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
            <path d="M12 3 5 6v5c0 4.6 2.8 8.8 7 10 4.2-1.2 7-5.4 7-10V6l-7-3Z" />
            <path d="m9.5 11.5 1.7 1.5 3.3-3.5" />
        </svg>
    </span>

    @* Existing badge wording remains unchanged. *@
    <span>Enterprise Secure</span>
</div>

@* =========================================================
   RESET-PASSWORD RETURN LINK
   Allows the employee to return to the completed sign-in page.
   It sits above the reset-password heading, matching the reference.
   ========================================================= *@
<p class="reset-back-link">
    @* The root route returns to the login page. *@
    <a href="/">← Back to sign in</a>
</p>
@* =========================================================
   RESET-PASSWORD PAGE HEADING
   Changes only the wording while preserving the existing
   position, typography, spacing, badge, and return link.
   ========================================================= *@
<div class="form-heading">
    @* Reset-password page title. *@
    <h2>Reset password</h2>

    @* Supporting instruction for choosing a new password. *@
    <p>Let’s create a new, strong password for your account.</p>
</div>

            @* =========================================================
   RESET-PASSWORD FORM
   Allows the employee to create and confirm a new password.
   Visual password validation is shown for now; functional
   validation and submission behaviour will be added later.
   ========================================================= *@
<form class="login-form reset-password-form">

    @* New-password field. *@
    <div class="form-group">
        <label for="new-password">New password</label>

        <div class="input-with-icon password-input">
            @* Lock icon inside the left side of the field. *@
            <span class="field-icon field-icon-left" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5" y="10" width="14" height="10" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>
            </span>

            @* New password entered by the employee. *@
            <input
                id="new-password"
                type="password"
                autocomplete="new-password"
                placeholder="Enter your new password" />

            @* Eye icon is visual for now and will become functional later. *@
            <span class="field-icon field-icon-right" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                    <circle cx="12" cy="12" r="2.5" />
                </svg>
            </span>
        </div>
    </div>

    @* =========================================================
   SEGMENTED PASSWORD-STRENGTH INDICATOR
   Matches the reference with two active segments, two muted
   segments, and the strength status aligned on the right.
   ========================================================= *@
<div class="password-strength" aria-label="Password strength: Strong">

    @* Four separate strength segments shown in one row. *@
    <div class="password-strength-segments" aria-hidden="true">
        <span class="password-strength-segment is-active"></span>
        <span class="password-strength-segment is-active"></span>
        <span class="password-strength-segment"></span>
        <span class="password-strength-segment"></span>
    </div>

    @* Current visual strength status. *@
    <strong class="password-strength-status">Strong</strong>
</div>

    @* Confirm-new-password field. *@
    <div class="form-group">
        <label for="confirm-new-password">Confirm new password</label>

        <div class="input-with-icon password-input">
            @* Lock icon inside the left side of the field. *@
            <span class="field-icon field-icon-left" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="5" y="10" width="14" height="10" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>
            </span>

            @* Password confirmation entered by the employee. *@
            <input
                id="confirm-new-password"
                type="password"
                autocomplete="new-password"
                placeholder="Confirm your new password" />

            @* Eye icon is visual for now and will become functional later. *@
            <span class="field-icon field-icon-right" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                    <circle cx="12" cy="12" r="2.5" />
                </svg>
            </span>
        </div>
    </div>

    @* =========================================================
   PASSWORD REQUIREMENTS
   Uses the exact heading and five criteria from the reference.
   ========================================================= *@
<div class="reset-password-requirements">

    @* Requirement-list heading from the reference. *@
    <strong>Password must include:</strong>

    @* Exact password criteria shown in a single vertical list. *@
    <div class="reset-requirements-list">

        <div class="reset-requirement">
            <span class="requirement-check" aria-hidden="true">✓</span>
            <span>At least 8 characters</span>
        </div>

        <div class="reset-requirement">
            <span class="requirement-check" aria-hidden="true">✓</span>
            <span>At least one uppercase letter (A–Z)</span>
        </div>

        <div class="reset-requirement">
            <span class="requirement-check" aria-hidden="true">✓</span>
            <span>At least one lowercase letter (a–z)</span>
        </div>

        <div class="reset-requirement">
            <span class="requirement-check" aria-hidden="true">✓</span>
            <span>At least one number (0–9)</span>
        </div>

        <div class="reset-requirement">
            <span class="requirement-check" aria-hidden="true">✓</span>
            <span>At least one special character (!@@#$%^&amp;*)</span>
        </div>

    </div>
</div>

    @* Reset-password action button. *@
    <button class="sign-in-button" type="button">
        Reset Password
    </button>
</form>

@* =========================================================
   RESET-PASSWORD COMPLETION NOTICE
   Replaces the login divider, account prompt, support card,
   and security note on this page only.
   ========================================================= *@
<div class="reset-success-panel">

    @* Green confirmation icon. *@
    <span class="reset-success-icon" aria-hidden="true">
        ✓
    </span>

    @* Explanation of what happens after the password is reset. *@
    <div class="reset-success-copy">
        <strong>You’re almost all set!</strong>

        <p>
            Once your password is reset, you’ll be signed in
            and redirected to your dashboard.
        </p>
    </div>
</div>

        </div>
    </section>
</main>