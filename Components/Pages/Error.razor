@* Presents a safe production error without exposing exception details. *@
@page "/Error"
@layout AuthLayout
@using System.Diagnostics

<PageTitle>Something Went Wrong | Secure Employee Portal</PageTitle>

<main class="simple-status-page">
    <section class="simple-status-card">
        <div class="simple-status-icon" aria-hidden="true">!</div>
        <p class="eyebrow">Secure Employee Portal</p>
        <h1>Something went wrong</h1>
        <p>We couldn’t complete that request. Try again, or return to the portal and continue from a known page.</p>

        @if (ShowRequestId)
        {
            <p class="portal-form-note">Reference: <code>@RequestId</code></p>
        }

        <div class="status-actions">
            <a class="portal-primary-link" href="/dashboard">Return to dashboard</a>
            <a class="portal-secondary-link" href="/">Go to sign in</a>
        </div>
    </section>
</main>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrWhiteSpace(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
