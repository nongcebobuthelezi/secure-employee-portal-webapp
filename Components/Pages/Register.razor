            @* =========================================================
   REGISTRATION FORM
   Adds the five account-creation fields while reusing the
   approved field, icon, and button styling from the login page.
   ========================================================= *@
@* Connects valid Registration submissions to the account-creation method. *@
<EditForm
    Model="Input"
    FormName="register"
    OnValidSubmit="RegisterUserAsync"
    class="login-form registration-form">

    @* Activates the validation rules declared on RegisterInputModel. *@
    <DataAnnotationsValidator />

    @* First and last name share the first form row. *@
    <div class="registration-field-row">

        @* First-name field bound to the Registration input model. *@
<div class="form-group">
    <label for="first-name">First name</label>

    <div class="input-with-icon">
        @* Decorative user icon inside the field. *@
        <span class="field-icon field-icon-left" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21a8 8 0 0 1 16 0" />
            </svg>
        </span>

        @* Store the submitted first name in Input.FirstName. *@
        <InputText
            id="first-name"
            @bind-Value="Input!.FirstName"
            autocomplete="given-name"
            placeholder="Enter your first name" />
    </div>

    @* Show the FirstName validation message when the form is submitted. *@
    <ValidationMessage For="() => Input!.FirstName" />
</div>

        @* Last-name field bound to the Registration input model. *@
<div class="form-group">
    <label for="last-name">Last name</label>

    <div class="input-with-icon">
        @* Decorative user icon inside the field. *@
        <span class="field-icon field-icon-left" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21a8 8 0 0 1 16 0" />
            </svg>
        </span>

        @* Store the submitted last name in Input.LastName. *@
        <InputText
            id="last-name"
            @bind-Value="Input!.LastName"
            autocomplete="family-name"
            placeholder="Enter your last name" />
    </div>

    @* Show the LastName validation message when required. *@
    <ValidationMessage For="() => Input!.LastName" />
</div>
    </div>

    @* Work-email field bound to the Registration input model. *@
<div class="form-group">
    <label for="work-email">Work email</label>

    <div class="input-with-icon">
        @* Decorative envelope icon inside the field. *@
        <span class="field-icon field-icon-left" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
            </svg>
        </span>

        @* Store the submitted email address in Input.WorkEmail. *@
        <InputText
            id="work-email"
            type="email"
            @bind-Value="Input!.WorkEmail"
            autocomplete="email"
            placeholder="Enter your work email address" />
    </div>

    @* Show the WorkEmail validation message when required. *@
    <ValidationMessage For="() => Input!.WorkEmail" />
</div>

    @* Password and confirmation fields share the final form row. *@
    <div class="registration-field-row">

        @* Password field bound to the Registration input model. *@
<div class="form-group">
    <label for="register-password">Password</label>

    <div class="input-with-icon password-input">
        @* Decorative lock icon inside the left side. *@
        <span class="field-icon field-icon-left" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <rect x="5" y="10" width="14" height="10" rx="2" />
                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
            </svg>
        </span>

        @* Store the submitted password in Input.Password. *@
        <InputText
            id="register-password"
            type="password"
            @bind-Value="Input!.Password"
            autocomplete="new-password"
            placeholder="Create a password" />

        @* Decorative eye icon inside the right side. *@
        <span class="field-icon field-icon-right" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                <circle cx="12" cy="12" r="2.5" />
            </svg>
        </span>
    </div>

    @* Show the Password validation message when required. *@
    <ValidationMessage For="() => Input!.Password" />
</div>

        @* Confirm-password field bound to the Registration input model. *@
<div class="form-group">
    <label for="confirm-password">Confirm password</label>

    <div class="input-with-icon password-input">
        @* Decorative lock icon inside the left side. *@
        <span class="field-icon field-icon-left" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <rect x="5" y="10" width="14" height="10" rx="2" />
                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
            </svg>
        </span>

        @* Store the repeated password in Input.ConfirmPassword. *@
        <InputText
            id="confirm-password"
            type="password"
            @bind-Value="Input!.ConfirmPassword"
            autocomplete="new-password"
            placeholder="Confirm your password" />

        @* Decorative eye icon inside the right side. *@
        <span class="field-icon field-icon-right" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                <circle cx="12" cy="12" r="2.5" />
            </svg>
        </span>
    </div>

    @* Show an error when the confirmation is missing or does not match. *@
    <ValidationMessage For="() => Input!.ConfirmPassword" />
</div>
    </div>

@* =========================================================
   PASSWORD REQUIREMENTS PANEL
   Displays the account password rules beneath the two
   password fields. Functional validation will be added later.
   ========================================================= *@
<div class="password-requirements">

    @* Small security-shield icon shown at the left of the panel. *@
    <div class="password-requirements-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
            <path d="M12 3 5 6v5c0 4.6 2.8 8.8 7 10 4.2-1.2 7-5.4 7-10V6l-7-3Z" />
            <path d="m9.5 11.5 1.7 1.5 3.3-3.5" />
        </svg>
    </div>

    @* Password-requirements heading and rule list. *@
    <div class="password-requirements-content">
        <strong>Password requirements</strong>

        @* The rules are arranged in two columns, matching the reference. *@
        <div class="password-requirements-grid">

            @* Minimum-length requirement. *@
            <div class="password-requirement">
                <span class="requirement-check" aria-hidden="true">✓</span>
                <span>At least 8 characters</span>
            </div>

            @* Special-character requirement. *@
            <div class="password-requirement">
                <span class="requirement-check" aria-hidden="true">✓</span>
                <span>Include a special character</span>
            </div>

            @* Uppercase-letter requirement. *@
            <div class="password-requirement">
                <span class="requirement-check" aria-hidden="true">✓</span>
                <span>Include uppercase letter</span>
            </div>

            @* Password-confirmation requirement. *@
            <div class="password-requirement">
                <span class="requirement-check" aria-hidden="true">✓</span>
                <span>Passwords must match</span>
            </div>

            @* Number requirement. *@
            <div class="password-requirement">
                <span class="requirement-check" aria-hidden="true">✓</span>
                <span>Include a number</span>
            </div>
        </div>
    </div>
</div>

@* =========================================================
   REGISTRATION TERMS AGREEMENT
   Binds the employee's acknowledgement to the Registration
   input model and displays an error when it is not accepted.
   ========================================================= *@
<div class="registration-terms-group">
    <label class="registration-terms">
        @* Store the checkbox state in Input.AcceptTerms. *@
        <InputCheckbox @bind-Value="Input!.AcceptTerms" />

        @* Agreement wording with links to the relevant policies. *@
        <span>
            I agree to the
            <a href="#">Terms of Service</a>
            and
            <a href="#">Privacy Policy</a>.
        </span>
    </label>

    @* Show an error when the policies have not been accepted. *@
    <ValidationMessage For="() => Input!.AcceptTerms" />
</div>

   @* Display account-level errors returned by ASP.NET Core Identity. *@
@if (IdentityErrors is not null)
{
    <div class="registration-errors" role="alert">
        <strong>We couldn’t create your account.</strong>

        <ul>
            @foreach (var error in IdentityErrors)
            {
                <li>@error.Description</li>
            }
        </ul>
    </div>
}

@* Submit the completed Registration form for validation
