@* Holds the submitted Registration values and account-creation logic. *@
@code {
    // Receive values posted by the uniquely named Registration form.
    [SupplyParameterFromForm(FormName = "register")]
    private SecureEmployeePortal.Models.RegisterInputModel? Input { get; set; }

    // Hold any account errors returned by ASP.NET Core Identity,
    // such as a duplicate email or an invalid password.
    private IEnumerable<IdentityError>? IdentityErrors { get; set; }

    // Create a blank input model on the first page load,
    // while preserving posted values during form submission.
    protected override void OnInitialized()
    {
        Input ??= new();
    }

    // Create a permanent Identity account after the submitted
    // Registration form has passed its validation rules.
    private async Task RegisterUserAsync()
    {
        // Clear errors left over from an earlier failed attempt.
        IdentityErrors = null;

        // Remove accidental spaces around the submitted email.
        var email = Input!.WorkEmail.Trim();

        // Convert the temporary Registration details into the
        // permanent employee-account type stored by Identity.
        var user = new ApplicationUser
        {
            UserName = email,
            Email = email,
            FirstName = Input.FirstName.Trim(),
            LastName = Input.LastName.Trim()
        };

        // Ask Identity to validate the password and create
        // the employee account in SQL Server.
        var result = await UserManager.CreateAsync(
            user,
            Input.Password);

        // Preserve Identity's explanations when creation fails.
        if (!result.Succeeded)
        {
            IdentityErrors = result.Errors;
            return;
        }

        // Return the newly registered employee to the Login page.
        NavigationManager.NavigateTo("/?registration=success");
    }
}
