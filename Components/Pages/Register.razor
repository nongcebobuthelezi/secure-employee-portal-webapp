@* Registration page route and shared authentication layout. *@
@page "/register"
@layout AuthLayout

@* Imports the Identity service used to create employee accounts. *@
@using Microsoft.AspNetCore.Identity

@* Imports the portal's customised employee-account class. *@
@using SecureEmployeePortal.Data

@* Provides the service that creates and validates Identity users. *@
@inject UserManager<ApplicationUser> UserManager

@* Provides navigation after successful account creation. *@
@inject NavigationManager NavigationManager


@* Browser-tab title for the account-creation page. *@
