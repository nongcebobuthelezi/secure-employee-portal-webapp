@* Secure password-reset request page. *@
@page "/forgot-password"
@layout AuthLayout
@rendermode InteractiveServer
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using SecureEmployeePortal.Data
@using SecureEmployeePortal.Models
@inject UserManager<ApplicationUser> UserManager
@inject SecureEmployeePortal.Services.PasswordResetDeliveryService ResetDelivery
@inject SecureEmployeePortal.Services.PortalActivityService ActivityService
@inject NavigationManager NavigationManager
@inject ILoggerFactory LoggerFactory

<PageTitle>Forgot Password | Secure Employee Portal</PageTitle>

<main class="login-shell auth-forgot-page">
    <section class="login-visual-panel">
        <div class="brand-row">
            <div class="brand-icon" aria-hidden="true"><svg viewBox="0 0 72 78">
                    <defs>
                        <linearGradient id="brandShieldStroke" x1="36" y1="5" x2="36" y2="73" gradientUnits="userSpaceOnUse">
                            <stop offset="0%" stop-color="#5EE4EA" />
                            <stop offset="48%" stop-color="#3CB6E8" />
                            <stop offset="100%" stop-color="#3269E5" />
                        </linearGradient>
                    </defs>
                    <path class="brand-shield-depth" d="M36 6 L61 15 V34 C61 51 51 65 36 72 C21 65 11 51 11 34 V15 Z" />
                    <path class="brand-shield-outline" d="M36 4 L61 13 V32 C61 49 51 63 36 70 C21 63 11 49 11 32 V13 Z" />
                    <circle class="brand-person-head" cx="36" cy="27" r="7.5" />
                    <path class="brand-person-body" d="M22 53 C22 43.5 28.2 37 36 37 C43.8 37 50 43.5 50 53 C50 55.2 48.2 57 46 57 H26 C23.8 57 22 55.2 22 53 Z" />
                </svg></div>
            <div><h1 class="brand-name">Secure <span>Employee Portal</span></h1><p class="brand-tagline">Secure Access. Trusted People. Stronger Organization.</p></div>
        </div>
        <div class="visual-content">
            <div class="visual-intro-row"><div class="dot-grid" aria-hidden="true"></div><div class="visual-copy"><h2>Security starts with you</h2><p class="visual-description">We’ll help you regain access to your account safely and securely.</p></div></div>
            <div class="illustration-wrapper"><img src="images/forgot-password-illustration.png" alt="Password recovery illustration" /></div>
        </div>
    </section>

    <section class="login-form-panel">
        <div class="form-panel-inner">
            <div class="security-badge">
                <span class="security-badge-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.6 2.8 8.8 7 10 4.2-1.2 7-5.4 7-10V6l-7-3Z" /><path d="m9.5 11.5 1.7 1.5 3.3-3.5" /></svg>
                </span>
                <span>Identity Protected</span>
            </div>
            <div class="form-heading"><h2>Forgot password?</h2><p>Enter your work email and we’ll prepare secure reset instructions.</p></div>

            @if (Submitted)
            {
                <div class="reset-info-panel" role="status"><p>If an account exists for this email address, password-reset instructions have been sent.</p></div>
            }

            <EditForm Model="Input" OnValidSubmit="RequestResetAsync" FormName="forgot-password" class="login-form">
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label for="reset-email">Work email</label>
                    <div class="input-with-icon">
                    <span class="field-icon field-icon-left" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                    </span>
                    <InputText id="reset-email" type="email" autocomplete="email" maxlength="256" @bind-Value="Input.Email" placeholder="Enter your work email" />
                </div>
                    <ValidationMessage For="() => Input.Email" />
                </div>
                <button class="sign-in-button" type="submit" disabled="@IsBusy">@(IsBusy ? "Preparing…" : "Send reset link")</button>
            </EditForm>

            <p class="create-account back-to-sign-in"><a href="/">← Back to sign in</a></p>
            <div class="reset-info-panel"><p>For privacy, this page gives the same response whether or not the email exists.</p></div>
        </div>
    </section>
</main>

@code {
    private ForgotPasswordInputModel Input { get; set; } = new();
    private bool Submitted { get; set; }
    private bool IsBusy { get; set; }

    private async Task RequestResetAsync()
    {
        if (IsBusy)
        {
            return;
        }

        IsBusy = true;
        Submitted = true;

        try
        {
            var email = Input.Email.Trim();
            var user = await UserManager.FindByEmailAsync(email);

            if (user is null)
            {
                return;
            }

            var token = await UserManager.GeneratePasswordResetTokenAsync(user);
            var code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(token));
            var link = NavigationManager.ToAbsoluteUri($"/reset-password?email={Uri.EscapeDataString(email)}&code={Uri.EscapeDataString(code)}").ToString();

            try
            {
                await ResetDelivery.SendAsync(email, link);
                await ActivityService.RecordSecurityEventAsync(
                    user.Id,
                    "PasswordResetRequested",
                    true,
                    "Password-reset instructions were requested.");
            }
            catch (Exception exception)
            {
                // Keep the public response neutral while recording an operational failure without the token.
                LoggerFactory.CreateLogger("PasswordReset").LogError(exception, "Password-reset delivery failed for an existing account.");
                await ActivityService.RecordSecurityEventAsync(
                    user.Id,
                    "PasswordResetDeliveryFailed",
                    false,
                    "Password-reset instructions could not be delivered.");
            }
        }
        finally
        {
            IsBusy = false;
        }
    }
}
