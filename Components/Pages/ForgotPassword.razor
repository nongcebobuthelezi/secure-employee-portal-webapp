@* =========================================================
   FORGOT-PASSWORD PAGE ROUTE
   Creates a separate authentication page while continuing
   to use the completed shared authentication layout.
   ========================================================= *@
@page "/forgot-password"
@layout AuthLayout

@* Browser-tab title for the password-recovery page. *@
<PageTitle>Forgot Password | Secure Employee Portal</PageTitle>

<main class="login-shell">
    <section class="login-visual-panel">
        <div class="brand-row">
<div class="brand-icon" aria-hidden="true">
    <svg viewBox="0 0 72 78">
        <defs>
            <linearGradient
                id="brandShieldStroke"
                x1="36"
                y1="5"
                x2="36"
                y2="73"
                gradientUnits="userSpaceOnUse">

                <stop offset="0%" stop-color="#5EE4EA" />
                <stop offset="48%" stop-color="#3CB6E8" />
                <stop offset="100%" stop-color="#3269E5" />
            </linearGradient>
        </defs>

        <path
            class="brand-shield-depth"
            d="M36 6
               L61 15
               V34
               C61 51 51 65 36 72
               C21 65 11 51 11 34
               V15
               Z" />

        <path
            class="brand-shield-outline"
            d="M36 4
               L61 13
               V32
               C61 49 51 63 36 70
               C21 63 11 49 11 32
               V13
               Z" />

        <circle
            class="brand-person-head"
            cx="36"
            cy="27"
            r="7.5" />

        <path
            class="brand-person-body"
            d="M22 53
               C22 43.5 28.2 37 36 37
               C43.8 37 50 43.5 50 53
               C50 55.2 48.2 57 46 57
               H26
               C23.8 57 22 55.2 22 53
               Z" />
    </svg>
</div>
            <div>
                <h1 class="brand-name">
                    Secure <span>Employee Portal</span>
                </h1>

                <p class="brand-tagline">
                    Secure Access. Trusted People. Stronger Organization.
                </p>
            </div>
        </div>

      <div class="visual-content">
    <div class="visual-intro-row">
        <div class="dot-grid" aria-hidden="true"></div>

        <div class="visual-copy">
    @* Password-recovery heading shown beside the dot grid. *@
    <h2>Security starts with you</h2>

    @* Supporting password-recovery message. *@
    <p class="visual-description">
        We’ll help you regain access to your account safely
        and securely.
    </p>
</div>

    </div>

  @* Forgot password page illustration block *@
<div class="illustration-wrapper">
    <img
        src="images/forgot-password-illustration.png"
        alt="Laptop with a password reset screen beside a reset card and envelope" />
</div>

</div>

        <div class="feature-row">
    <div class="feature-item">
        <div class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <rect x="5" y="10" width="14" height="10" rx="2" />
                <path d="M8 10V7a4 4 0 0 1 8 0v3" />
            </svg>
        </div>

        <div class="feature-copy">
            <strong>Secure by design</strong>
            <span>Enterprise-grade encryption</span>
        </div>
    </div>

    <div class="feature-item">
        <div class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <circle cx="12" cy="8" r="4" />
                <path d="M4 21a8 8 0 0 1 16 0" />
            </svg>
        </div>

        <div class="feature-copy">
            <strong>Protecting your data</strong>
            <span>Your information is always private</span>
        </div>
    </div>

    <div class="feature-item">
        <div class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                <path d="M10 21h4" />
            </svg>
        </div>

        <div class="feature-copy">
            <strong>You’re in control</strong>
            <span>Reset your password, not your security</span>
        </div>
    </div>
</div>

    </section>

    <section class="login-form-panel">
        <div class="form-panel-inner">
            @* =========================================================
   ENTERPRISE SECURE BADGE
   Adds the small outlined security icon shown in the reference.
   ========================================================= *@
<div class="security-badge">
    @* Small outlined shield icon positioned before the badge text. *@
    <span class="security-badge-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
            <path d="M12 3 5 6v5c0 4.6 2.8 8.8 7 10 4.2-1.2 7-5.4 7-10V6l-7-3Z" />
            <path d="m9.5 11.5 1.7 1.5 3.3-3.5" />
        </svg>
    </span>

    @* Existing badge wording remains unchanged. *@
    <span>Enterprise Secure</span>
</div>

            @* =========================================================
   FORGOT-PASSWORD PAGE HEADING
   Changes only the right-panel wording while preserving the
   existing position, typography, spacing, and badge.
   ========================================================= *@
<div class="form-heading">
    @* Password-recovery page title. *@
    <h2>Forgot password?</h2>

    @* Instructions for requesting a secure reset link. *@
    <p>
        No problem. Enter your work email and we’ll send you a
        secure link to reset your password.
    </p>
</div>

            @* =========================================================
   FORGOT-PASSWORD FORM
   Collects the employee’s work email so a secure password-
   reset link can be requested. Backend behaviour comes later.
   ========================================================= *@
<form class="login-form">

    @* Full-width work-email field. *@
    <div class="form-group">
        <label for="reset-email">Work email</label>

        <div class="input-with-icon">
            @* Decorative envelope icon inside the left side. *@
            <span class="field-icon field-icon-left" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                </svg>
            </span>

            @* Email address used for the reset-link request. *@
            <input
                id="reset-email"
                type="email"
                autocomplete="email"
                placeholder="Enter your work email" />
        </div>
    </div>

    @* Sends the password-reset request when functionality is added. *@
    <button class="sign-in-button" type="button">
        Send reset link
    </button>
</form>

            <div class="account-divider">
                <span></span>
                <p>or</p>
                <span></span>
            </div>

            @* =========================================================
   BACK-TO-SIGN-IN LINK
   Returns the user to the completed login page at the root route.
   ========================================================= *@
<p class="create-account back-to-sign-in">
    @* Returns the employee to the completed login page. *@
    <a href="/">← Back to sign in</a>
</p>

@* =========================================================
   PASSWORD-RESET INFORMATION PANEL
   Uses neutral wording so the page does not reveal whether
   a particular work-email account exists.
   ========================================================= *@
<div class="reset-info-panel">
    @* Small outlined information icon. *@
    <div class="reset-info-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5" />
            <path d="M12 8h.01" />
        </svg>
    </div>

    @* Neutral password-reset confirmation message. *@
    <p>
        If an account exists for this email, reset instructions
        will be sent.
    </p>
</div>

            <div class="support-card">
    <div class="support-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
            <path d="M4 13v-1a8 8 0 0 1 16 0v1" />
            <path d="M4 13a2 2 0 0 1 2-2h1v7H6a2 2 0 0 1-2-2v-3Z" />
            <path d="M20 13a2 2 0 0 0-2-2h-1v7h1a2 2 0 0 0 2-2v-3Z" />
            <path d="M17 18c0 2-2 3-5 3" />
        </svg>
    </div>

    <div class="support-copy">
        <strong>Need help?</strong>
        <span>Contact the IT Support Team</span>

        <div class="support-contact">
            <a href="mailto:support@company.com">support@company.com</a>
            <span>• +1 (555) 123-4567</span>
        </div>
    </div>

    <div class="support-chevron" aria-hidden="true">
        <svg viewBox="0 0 24 24">
            <path d="m9 18 6-6-6-6" />
        </svg>
    </div>
</div>

<div class="security-note">
    <div class="security-note-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
            <path d="M12 3 5 6v5c0 4.6 2.8 8.8 7 10 4.2-1.2 7-5.4 7-10V6l-7-3Z" />
            <path d="M12 8v5" />
            <path d="M12 16h.01" />
        </svg>
    </div>

    <p>
        Secure Employee Portal is protected by state-of-the-art
        encryption and compliance standards.
    </p>
</div>

            
        </div>
    </section>
</main>