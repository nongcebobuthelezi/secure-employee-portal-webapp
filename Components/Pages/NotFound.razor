@* Consistent not-found experience for unknown portal routes. *@
@page "/not-found"
@layout AuthLayout

<PageTitle>Page Not Found | Secure Employee Portal</PageTitle>

<main class="simple-status-page">
    <section class="simple-status-card">
        <div class="simple-status-icon" aria-hidden="true">404</div>
        <p class="eyebrow">Secure Employee Portal</p>
        <h1>Page not found</h1>
        <p>The address may be incorrect, or the page may have moved.</p>
        <div class="status-actions">
            <a class="portal-primary-link" href="/dashboard">Go to dashboard</a>
            <a class="portal-secondary-link" href="/">Go to sign in</a>
        </div>
    </section>
</main>
