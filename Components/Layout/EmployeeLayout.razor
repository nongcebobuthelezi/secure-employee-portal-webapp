@* =========================================================
   AUTHENTICATED EMPLOYEE LAYOUT
   Keeps the approved Secure Employee Portal visual language
   while exposing only routes that genuinely belong to the final scoped portal.
   ========================================================= *@
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SecureEmployeePortal.Data
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<div class="employee-shell">
    <aside class="employee-sidebar" id="employee-sidebar">
        <div class="sidebar-header">
            <button class="sidebar-menu-button" type="button" data-sidebar-toggle aria-controls="employee-sidebar" aria-expanded="false" aria-label="Close navigation">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" />
                </svg>
            </button>

            <a class="sidebar-brand" href="/dashboard">
                <span class="sidebar-brand-icon" aria-hidden="true">
                    <svg viewBox="0 0 64 72">
                        <defs>
                            <linearGradient id="sidebarShieldGradient" x1="8" y1="6" x2="54" y2="66" gradientUnits="userSpaceOnUse">
                                <stop offset="0%" stop-color="#55E1E6" />
                                <stop offset="55%" stop-color="#2E92F5" />
                                <stop offset="100%" stop-color="#2359E4" />
                            </linearGradient>
                        </defs>
                        <path class="sidebar-shield-depth" d="M32 4 56 13v20c0 16-9 27-24 35C17 60 8 49 8 33V13L32 4Z" />
                        <path class="sidebar-shield-outline" d="M32 4 56 13v20c0 16-9 27-24 35C17 60 8 49 8 33V13L32 4Z" />
                        <circle class="sidebar-person-head" cx="32" cy="25" r="8" />
                        <path class="sidebar-person-body" d="M19 51c1-10 6-15 13-15s12 5 13 15H19Z" />
                    </svg>
                </span>
                <span class="sidebar-brand-name">
                    <span class="sidebar-brand-secure">Secure</span>
                    <span class="sidebar-brand-gradient">Employee Portal</span>
                </span>
            </a>
        </div>

        @* The final scoped portal deliberately avoids links to unfinished payroll/HR-style features. *@
        <nav class="sidebar-navigation" aria-label="Employee portal navigation">
            <NavLink class="sidebar-link" ActiveClass="is-active" Match="NavLinkMatch.All" href="/dashboard">
                <span class="sidebar-link-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m3 11 9-8 9 8" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" /></svg>
                </span>
                <span>Home</span>
            </NavLink>

            <NavLink class="sidebar-link" ActiveClass="is-active" href="/profile">
                <span class="sidebar-link-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="4" /><path d="M5 21c0-5 2.7-8 7-8s7 3 7 8" /></svg>
                </span>
                <span>My Profile</span>
            </NavLink>

            <NavLink class="sidebar-link" ActiveClass="is-active" href="/security">
                <span class="sidebar-link-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 3 20 6v6c0 5-2.9 8-8 10-5.1-2-8-5-8-10V6Z" /><path d="m9.5 12 1.7 1.7 3.7-4" /></svg>
                </span>
                <span>My Security</span>
            </NavLink>

            <NavLink class="sidebar-link" ActiveClass="is-active" href="/attendance">
                <span class="sidebar-link-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M12 8v5l3 2" /><path d="M9 2h6" /></svg>
                </span>
                <span>My Attendance</span>
            </NavLink>

            <NavLink class="sidebar-link" ActiveClass="is-active" href="/requests">
                <span class="sidebar-link-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M6 3h12v18H6Z" /><path d="M9 8h6" /><path d="M9 12h6" /><path d="M9 16h4" /></svg>
                </span>
                <span>Access Requests</span>
            </NavLink>

            <NavLink class="sidebar-link" ActiveClass="is-active" href="/account-activity">
                <span class="sidebar-link-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M4 12a8 8 0 1 0 2-5.3" /><path d="M4 4v5h5" /><path d="M12 8v5l3 2" /></svg>
                </span>
                <span>Account Activity</span>
            </NavLink>

            <AuthorizeView Roles="Manager,Administrator">
                <Authorized>
                    <NavLink class="sidebar-link" ActiveClass="is-active" href="/manager">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><circle cx="8" cy="8" r="3" /><circle cx="17" cy="9" r="2.5" /><path d="M2.5 20c.3-4.4 2.1-6.5 5.5-6.5s5.2 2.1 5.5 6.5" /><path d="M14 14.5c3.7-.5 6.5 1.2 7.5 5.5" /></svg>
                        </span>
                        <span>My Team</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Administrator">
                <Authorized>
                    <NavLink class="sidebar-link" ActiveClass="is-active" href="/admin">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M8 9h8" /><path d="M8 13h8" /><path d="M8 17h5" /></svg>
                        </span>
                        <span>Security Admin</span>
                    </NavLink>

                    <NavLink class="sidebar-link" ActiveClass="is-active" href="/admin/users">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" /><path d="M3 20c.3-4.4 2.3-6.5 6-6.5 2.6 0 4.4 1 5.3 3" /><path d="M17 13v7" /><path d="M13.5 16.5h7" /></svg>
                        </span>
                        <span>User Management</span>
                    </NavLink>

                    <NavLink class="sidebar-link" ActiveClass="is-active" href="/admin/roles">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 3 20 6v6c0 5-2.9 8-8 10-5.1-2-8-5-8-10V6Z" /><path d="M8 12h8" /><path d="M10 9h4" /></svg>
                        </span>
                        <span>Roles &amp; Permissions</span>
                    </NavLink>

                    <NavLink class="sidebar-link" ActiveClass="is-active" href="/admin/access-requests">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M5 4h14v16H5Z" /><path d="m9 12 2 2 4-5" /></svg>
                        </span>
                        <span>Access Review</span>
                    </NavLink>

                    <NavLink class="sidebar-link" ActiveClass="is-active" href="/admin/security-events">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 3 20 6v6c0 5-2.9 8-8 10-5.1-2-8-5-8-10V6Z" /><path d="M12 8v5" /><path d="M12 17h.01" /></svg>
                        </span>
                        <span>Security Events</span>
                    </NavLink>

                    <NavLink class="sidebar-link" ActiveClass="is-active" href="/admin/audit-logs">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M6 3h12v18H6Z" /><path d="M9 8h6" /><path d="M9 12h6" /><path d="M9 16h6" /></svg>
                        </span>
                        <span>Audit Logs</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>
            <NavLink class="sidebar-link" ActiveClass="is-active" href="/support">
                <span class="sidebar-link-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M9.6 9a2.6 2.6 0 1 1 4.5 1.8c-1.4 1.2-2.1 1.6-2.1 3" /><path d="M12 17h.01" /></svg>
                </span>
                <span>Help &amp; Support</span>
            </NavLink>
        </nav>

        <section class="sidebar-security-card">
            <span class="sidebar-security-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 3 20 6v6c0 5-2.9 8-8 10-5.1-2-8-5-8-10V6Z" /><path d="m9.5 12 1.7 1.7 3.7-4" /></svg>
            </span>
            <strong>Your security matters</strong>
            <p>Use a strong, unique password and change it if you suspect compromise.</p>
            <a class="sidebar-security-link" href="/security"><span>Review security</span><span aria-hidden="true">→</span></a>
        </section>
    </aside>

    @* Mobile navigation backdrop is activated by portal-ui.js. *@
    <button class="sidebar-backdrop" type="button" data-sidebar-close aria-label="Close navigation"></button>

    <section class="employee-workspace">
        <header class="employee-topbar">
            <button class="mobile-menu-button" type="button" data-sidebar-toggle aria-controls="employee-sidebar" aria-expanded="false" aria-label="Open navigation">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /></svg>
            </button>

            <div class="employee-topbar-actions">
                <a class="topbar-help-button" href="/dashboard?assistant=open" aria-label="Open Secure Assistant">
                    <span class="topbar-help-icon" aria-hidden="true"><img src="images/secure-assistant-icon.svg" alt="" /></span>
                    <span>Need help?</span>
                </a>

                <a class="topbar-notification-button" href="/account-activity" aria-label="Open account activity">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 17h12" /><path d="M8 17V10a4 4 0 0 1 8 0v7" /><path d="M10 20h4" /><path d="M5 17c1.3-1.2 2-2.8 2-4.6" /><path d="M19 17c-1.3-1.2-2-2.8-2-4.6" /></svg>
                </a>

                <a class="topbar-profile-button" href="/profile" aria-label="Open employee profile">
                    <span class="topbar-avatar-placeholder" aria-hidden="true">@EmployeeInitials</span>
                    <span class="topbar-profile-name">@EmployeeName</span>
                </a>

                @* Logout is a POST so the authentication cookie is changed in a normal HTTP response. *@
                <form action="/account/logout" method="post" class="topbar-logout-form">
                    <AntiforgeryToken />
                    <button type="submit" class="topbar-logout-button">Sign out</button>
                </form>
            </div>
        </header>

        <main class="employee-content">
            @Body
        </main>
    </section>
</div>

@code {
    private string EmployeeName { get; set; } = "Employee";
    private string EmployeeInitials { get; set; } = "EP";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user is not null)
        {
            EmployeeName = string.IsNullOrWhiteSpace(user.FullName)
                ? user.Email ?? "Employee"
                : user.FullName;

            var firstInitial = string.IsNullOrWhiteSpace(user.FirstName) ? string.Empty : user.FirstName[..1];
            var lastInitial = string.IsNullOrWhiteSpace(user.LastName) ? string.Empty : user.LastName[..1];
            EmployeeInitials = $"{firstInitial}{lastInitial}".ToUpperInvariant();
            if (string.IsNullOrWhiteSpace(EmployeeInitials))
            {
                EmployeeInitials = "EP";
            }
        }
    }
}
